# Зарубежный вход: только пересылает запросы на основной сервер, ничего не хранит.
# Люди с VPN (туннель за границу) не достукиваются до российского сервера напрямую,
# а до этого сервера — да; отсюда до Москвы трафик идёт из дата-центра и проходит.
{
	servers {
		protocols h1 h2
	}
}

{$EDGE_DOMAIN} {
	log {
		output stdout
		format console
	}
	encode zstd gzip
	# Приложение, открытое с основного домена, при недоступности сервера ходит к API сюда — нужен CORS
	@cors header Origin https://{$ORIGIN}
	header @cors {
		Access-Control-Allow-Origin "https://{$ORIGIN}"
		Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
		Access-Control-Allow-Headers "authorization, content-type"
		Access-Control-Max-Age "86400"
		Vary Origin
		defer
	}
	@preflight {
		method OPTIONS
		header Origin https://{$ORIGIN}
	}
	respond @preflight 204
	reverse_proxy https://{$ORIGIN} {
		header_up Host {$ORIGIN}
		# Основной сервер строит ссылки (приглашения, карточки) с этим доменом
		header_up X-Polovinka-Host {host}
		# SSE: отдавать события сразу, не буферизуя
		flush_interval -1
		transport http {
			tls_server_name {$ORIGIN}
		}
	}
}
