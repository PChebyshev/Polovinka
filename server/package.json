{
  "name": "@polovinka/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json && cp src/schema.sql dist/server/src/schema.sql",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "@polovinka/shared": "*",
    "fastify": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "~5.9.3"
  }
}
