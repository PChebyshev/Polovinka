# Скопируйте в .env рядом с docker-compose.yml и заполните.
# Домен, на который указывает A-запись сервера. Caddy сам получит сертификат.
DOMAIN=example.ru
# Ключ для страницы /stats. Пустой ключ выключает страницу.
STATS_KEY=
# Почта для push-сервисов браузеров (контакт владельца VAPID-ключей).
VAPID_EMAIL=you@example.ru
# Почта для кодов входа (необязательно). Без этих строк вход по почте выключен.
# Яндекс: smtp.yandex.ru, порт 465, пароль приложения из id.yandex.ru/security.
# Mail.ru: smtp.mail.ru, порт 465, пароль для внешних приложений.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Страница «Что мы храним» (необязательно).
# Где физически стоит сервер — посмотрите в панели Timeweb, например: Россия, Санкт-Петербург
DATA_LOCATION=
# Почта для вопросов о данных
PRIVACY_CONTACT=
# Оператор персональных данных: ФИО или ИП/ООО, как в уведомлении Роскомнадзора
OPERATOR_NAME=
