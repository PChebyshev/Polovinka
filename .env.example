# Скопируйте в .env рядом с docker-compose.yml и заполните.
# Домен, на который указывает A-запись сервера. Caddy сам получит сертификат.
DOMAIN=example.ru
# Ключ для страницы /stats. Пустой ключ выключает страницу.
STATS_KEY=
# Почта для push-сервисов браузеров (контакт владельца VAPID-ключей).
VAPID_EMAIL=you@example.ru
# Почта для кодов входа. Без этих строк вход по почте выключен.
# Mail.ru: smtp.mail.ru, порт 465, пароль для внешних приложений (id.mail.ru → Безопасность).
# Яндекс: smtp.yandex.ru, порт 465, пароль приложения из id.yandex.ru/security.
# SMTP_USER и SMTP_FROM — один и тот же адрес ящика.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Когда почта настроена, после первого ответа приложение просит привязать почту. 0 — не просить.
EMAIL_REQUIRED=1
# Страница «Что мы храним» (необязательно).
# Где физически стоит сервер — посмотрите в панели Timeweb, например: Россия, Санкт-Петербург
DATA_LOCATION=
# Почта для вопросов о данных
PRIVACY_CONTACT=
# Оператор персональных данных: ФИО или ИП/ООО, как в уведомлении Роскомнадзора
OPERATOR_NAME=
# ИИ для персональных идей и вопросов по истории (необязательно).
# Без него идеи берутся из заранее написанных. Варианты: anthropic | yandex
AI_PROVIDER=
# Claude: ключ из console.anthropic.com. С российского сервера нужен прокси (ANTHROPIC_BASE_URL)
ANTHROPIC_API_KEY=
AI_MODEL=
# YandexGPT: API-ключ сервисного аккаунта и ID каталога из Yandex Cloud
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Ежедневная зашифрованная копия базы в облачное хранилище (необязательно, но очень желательно).
# Yandex Object Storage: бакет + статический ключ сервисного аккаунта с ролями storage.uploader и storage.viewer.
# BACKUP_PASSWORD придумайте сами и сохраните вне сервера — без него копию не расшифровать.
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
BACKUP_PASSWORD=
# Только для Timeweb S3: https://s3.timeweb.cloud и ru-1
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
# Зарубежные входы (отдельные серверы-прокси для людей с VPN), через запятую: go.polovinka.online
EDGE_HOSTS=
