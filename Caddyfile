# HTTP/3 выключен: UDP 443 наружу не открыт, а объявленный h3 заставляет браузер через VPN
# (где UDP часто глохнет без ответа) ждать таймаут QUIC, прежде чем открыть сайт по TCP.
{
	servers {
		protocols h1 h2
	}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8787 {
		flush_interval -1
	}
}

# www.домен → домен. Если A-записи для www нет, Caddy просто не получит
# для неё сертификат, основной адрес это не затрагивает.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
